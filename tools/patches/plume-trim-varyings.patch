 #include <cstdlib>
 #include <cstring>
 #include "plume_log.h"
@@ -1384,6 +1389,74 @@ namespace plume {
 
     // VulkanShader
 
+    // LostOdysseyRecomp: LO_TRIM_VARYINGS=1 gives each pipeline a vertex shader
+    // without the outputs its fragment shader does not read (all of them for a
+    // depth-only pipeline). See plume_spirv_trim.h.
+    static bool trimVaryingsEnabled() {
+        static const bool enabled = [] {
+            const char *value = std::getenv("LO_TRIM_VARYINGS");
+            return (value != nullptr) && (value[0] == '1') && (value[1] == '\0');
+        }();
+        return enabled;
+    }
+
+    static VkShaderModule vertexModuleFor(const RenderGraphicsPipelineDesc &desc) {
+        VulkanShader *vertexShader = const_cast<VulkanShader *>(static_cast<const VulkanShader *>(desc.vertexShader));
+        if (!trimVaryingsEnabled() || (desc.geometryShader != nullptr) || vertexShader->spirv.empty()) {
+            return vertexShader->vk;
+        }
+
+        uint32_t keepMask = 0;
+        if (desc.pixelShader != nullptr) {
+            VulkanShader *pixelShader = const_cast<VulkanShader *>(static_cast<const VulkanShader *>(desc.pixelShader));
+            std::lock_guard lock(pixelShader->variantMutex);
+            if (pixelShader->fragmentInputMask == -2) {
+                uint32_t mask = 0;
+                pixelShader->fragmentInputMask = (!pixelShader->spirv.empty() &&
+                    spirv_trim::FragmentInputMask(pixelShader->spirv.data(), pixelShader->spirv.size(), mask)) ? int64_t(mask) : -1;
+                std::vector<uint32_t>().swap(pixelShader->spirv); // only the mask is needed from a fragment shader
+            }
+
+            if (pixelShader->fragmentInputMask < 0) {
+                return vertexShader->vk;
+            }
+
+            keepMask = uint32_t(pixelShader->fragmentInputMask);
+        }
+
+        static std::atomic<uint32_t> variantCount{ 0 }, removedTotal{ 0 };
+        std::lock_guard lock(vertexShader->variantMutex);
+        auto it = vertexShader->outputVariants.find(keepMask);
+        if (it != vertexShader->outputVariants.end()) {
+            return (it->second != VK_NULL_HANDLE) ? it->second : vertexShader->vk;
+        }
+
+        VkShaderModule module = VK_NULL_HANDLE;
+        std::vector<uint32_t> trimmed;
+        uint32_t removed = 0;
+        if (spirv_trim::TrimOutputs(vertexShader->spirv.data(), vertexShader->spirv.size(), keepMask, trimmed, &removed)) {
+            VkShaderModuleCreateInfo shaderInfo = {};
+            shaderInfo.sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
+            shaderInfo.pCode = trimmed.data();
+            shaderInfo.codeSize = trimmed.size() * sizeof(uint32_t);
+            if (vkCreateShaderModule(vertexShader->device->vk, &shaderInfo, nullptr, &module) != VK_SUCCESS) {
+                module = VK_NULL_HANDLE;
+            }
+        }
+
+        vertexShader->outputVariants.emplace(keepMask, module);
+        if (module != VK_NULL_HANDLE) {
+            const uint32_t count = ++variantCount;
+            const uint32_t total = (removedTotal += removed);
+            if ((count <= 3) || ((count % 100) == 0)) {
+                std::fprintf(stderr, "[trim] vertex shader variant %u: kept mask 0x%x, %u outputs removed (%u removed in all variants)\n",
+                    count, keepMask, removed, total);
+            }
+        }
+
+        return (module != VK_NULL_HANDLE) ? module : vertexShader->vk;
+    }
+
     VulkanShader::VulkanShader(VulkanDevice *device, const void *data, uint64_t size, const char *entryPointName, RenderShaderFormat format) {
         assert(device != nullptr);
         assert(data != nullptr);
@@ -1404,14 +1477,25 @@ namespace plume {
             PLUME_LOG_ERROR("Vulkan", "vkCreateShaderModule", LogErrorDomain::VkResult, res, "");
             return;
         }
+
+        if (trimVaryingsEnabled() && ((size % 4) == 0)) {
+            spirv.assign(reinterpret_cast<const uint32_t *>(data), reinterpret_cast<const uint32_t *>(data) + (size / 4));
+        }
     }
 
     VulkanShader::~VulkanShader() {
+        for (auto &variant : outputVariants) {
+            if (variant.second != VK_NULL_HANDLE) {
+                vkDestroyShaderModule(device->vk, variant.second, nullptr);
+            }
+        }
+
         if (vk != VK_NULL_HANDLE) {
             vkDestroyShaderModule(device->vk, vk, nullptr);
         }
     }
 
+
     void VulkanShader::setName(const std::string &name) {
         setObjectName(device->vk, VK_OBJECT_TYPE_SHADER_MODULE, uint64_t(vk), name);
     }
@@ -1537,7 +1621,7 @@ namespace plume {
             VkPipelineShaderStageCreateInfo stageInfo = {};
             stageInfo.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
             stageInfo.stage = VK_SHADER_STAGE_VERTEX_BIT;
-            stageInfo.module = vertexShader->vk;
+            stageInfo.module = vertexModuleFor(desc);
             stageInfo.pName = vertexShader->entryPointName.c_str();
             stageInfo.pSpecializationInfo = pSpecInfo;
             stages.emplace_back(stageInfo);
@@ -2063,7 +2147,7 @@ namespace plume {
         });
 
         // Pre-rasterization: depth bias enable is static (it needs extended dynamic state 2).
-        const VkShaderModule vertexModule = static_cast<const VulkanShader *>(desc.vertexShader)->vk;
+        const VkShaderModule vertexModule = vertexModuleFor(desc);
         const VkShaderModule geometryModule = (desc.geometryShader != nullptr) ? static_cast<const VulkanShader *>(desc.geometryShader)->vk : VK_NULL_HANDLE;
         const VkBool32 depthClamp = !desc.depthClipEnabled;
         const VkBool32 depthBias = (desc.depthBias != 0) || (desc.depthBiasClamp != 0.0f) || (desc.slopeScaledDepthBias != 0.0f);
@@ -2080,6 +2164,7 @@ namespace plume {
             VkPipelineShaderStageCreateInfo stages[2];
             uint32_t stageCount = 0;
             stages[stageCount++] = libraryStage(desc.vertexShader, VK_SHADER_STAGE_VERTEX_BIT);
+            stages[stageCount - 1].module = vertexModule;
             if (desc.geometryShader != nullptr) {
                 stages[stageCount++] = libraryStage(desc.geometryShader, VK_SHADER_STAGE_GEOMETRY_BIT);
             }
