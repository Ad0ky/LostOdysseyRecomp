@@ -183,6 +183,14 @@ namespace plume {
         VulkanDevice *device = nullptr;
         RenderShaderFormat format = RenderShaderFormat::UNKNOWN;
 
+        // LostOdysseyRecomp (LO_TRIM_VARYINGS): the SPIR-V is kept so pipelines can
